    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst counts = { total: items.length, APPLY: 0, REVIEW: 0, REJECT: 0 };\nitems.forEach(function(it){ const d = it.json.decision; if (counts[d] !== undefined) counts[d]++; });\nreturn items.map(function(it){ const out = Object.assign({}, it.json); out._decision_counts = counts; return { json: out }; });"
      },
