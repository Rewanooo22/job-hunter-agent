    {
      "parameters": {
        "jsCode": "const mockCtx = $(\"Mock Submission\").item.json;\nconst pkg = mockCtx.package;\nconst binary = {};\nlet hasPdf = false;\nif (pkg.cv_file && pkg.cv_file.indexOf(\"data:application/pdf;base64,\") === 0) {\n  const b64 = pkg.cv_file.split(\"base64,\")[1];\n  binary.cv_pdf = { data: b64, mimeType: \"application/pdf\", fileName: \"tailored_cv.pdf\" };\n  hasPdf = true;\n}\nconst coverText = pkg.cover_letter_file || \"\";\nbinary.cover_letter = { data: Buffer.from(coverText, \"utf-8\").toString(\"base64\"), mimeType: \"text/plain\", fileName: \"cover_letter.txt\" };\nreturn [{ json: { package: pkg, has_pdf_attachment: hasPdf }, binary: binary }];"
      },
