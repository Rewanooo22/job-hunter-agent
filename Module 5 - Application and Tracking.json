    {
      "parameters": {
        "jsCode": "const resp = $input.item.json;\nconst records = (resp && Array.isArray(resp.records)) ? resp.records : [];\nconst counts = { submitted: 0, failed: 0, skipped_duplicate: 0, pending_approval: 0, total: records.length };\nrecords.forEach(function(r) {\n  const status = r.fields && r.fields.application_status;\n  if (status && counts[status] !== undefined) { counts[status]++; }\n});\nreturn [{ json: { statistics: counts, generated_at: new Date().toISOString(), note: \"Computed from the Airtable tracking table current contents at query time; requires the Airtable base/table and credential to be configured.\" } }];"
      },
