        "jsCode": "// Mock submission only -- never contacts the real employer application_url, per brief section 16/rules.\n// Real validation: a missing/invalid application_url is treated as a permanent failure (not retryable -- bad data, not a transient error).\nconst pkg = $input.item.json.package;\nconst urlValid = !!(pkg.application_url && /^https?:\\/\\//.test(pkg.application_url));\nreturn [{ json: { package: pkg, url_valid: urlValid, submitted_at: new Date().toISOString(), attempts: 1 } }];"
