    {
      "parameters": {
        "jsCode": "const resp = $input.item.json;\nconst pkgData = $(\"Validate Package\").item.json.package;\nlet isDuplicate = false;\nlet checkStatus = \"ok\";\nif (!resp || resp.error || !Array.isArray(resp.records)) { checkStatus = \"unavailable\"; }\nelse { isDuplicate = resp.records.length > 0; }\nreturn [{ json: { is_duplicate: isDuplicate, duplicate_check_status: checkStatus, package: pkgData } }];"
      },
