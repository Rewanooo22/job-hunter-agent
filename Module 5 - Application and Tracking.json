    {
      "parameters": {
        "jsCode": "const pkg = $input.item.json.application_package;\nconst REQUIRED = [\"candidate_id\",\"candidate_email\",\"job_id\",\"job_title\",\"company\",\"application_url\",\"fact_check\"];\nconst errors = [];\nif (!pkg) { errors.push(\"application_package missing entirely\"); }\nelse {\n  for (const f of REQUIRED) { if (pkg[f] === undefined || pkg[f] === null) { errors.push(\"Missing field: \" + f); } }\n  if (pkg.fact_check && pkg.fact_check.passed !== true) { errors.push(\"fact_check.passed is not true - package not trustworthy for submission\"); }\n}\nreturn [{ json: { valid: errors.length === 0, errors: errors, package: pkg } }];"
      },
      "id": "3b9ff0b7-3f71-4cf2-bf16-a904e08dead7",
      "name": "Validate Package",
      "type": "n8n-nodes-base.code",
