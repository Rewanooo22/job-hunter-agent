      "parameters": {
        "jsCode": "const resumed = $input.item.json;\nconst pkg = $(\"Parse Duplicate Check\").item.json.package;\n\n// n8n form returns \"Decision\" with capital D\nconst decision =\n  resumed.Decision ||\n  resumed.decision ||\n  (resumed.data && (resumed.data.Decision || resumed.data.decision)) ||\n  null;\n\nreturn [{\n  json: {\n    decision: decision,\n    package: pkg\n  }\n}];"
      },
